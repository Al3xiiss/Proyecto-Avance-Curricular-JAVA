    private void gestionarAsignaturasProfesor(RegistroProfesores registroProfesores) {
        System.out.print("\nIngrese ID del profesor para gestionar sus asignaturas: ");
        String id = leerTexto();

        try {
            // Buscamos al profesor usando el método del registro que ya lanza excepción
            Profesor profesor = registroProfesores.buscarProfesor(id);
            int opcion;

            do {
                System.out.println("\n--- ASIGNATURAS DICTADAS POR: " + profesor.getNombre().toUpperCase() + " ---");
                System.out.println("1. Agregar nueva Asignatura");
                System.out.println("2. Ver listado de asignaturas");
                System.out.println("3. Editar nombre de asignatura");
                System.out.println("4. Eliminar asignatura");
                System.out.println("5. Buscar asignatura específica");
                System.out.println("6. Volver");
                System.out.print("Seleccione una opción: ");

                opcion = leerEntero();

                switch (opcion) {
                    case 1:
                        asignarNuevaAsignatura(profesor);
                        break;
                    case 2:
                        verAsignaturasProfesor(profesor);
                        break;
                    case 3:
                        editarAsignaturaProfesor(profesor);
                        break;
                    case 4:
                        eliminarAsignaturaProfesor(profesor);
                        break;
                    case 5:
                        buscarAsignaturaProfesor(profesor);
                        break;
                    case 6:
                        System.out.println("Regresando...");
                        break;
                    default:
                        System.out.println("Opción inválida.");
                }
            } while (opcion != 6);

        } catch (EntidadNoEncontradaException e) {
            // Atrapa el error si el ID del profesor no existe
            System.out.println(e.getMessage());
        }
    }

    private void asignarNuevaAsignatura(Profesor profesor) {
        System.out.println("\nTipo: 1. Obligatoria | 2. Electiva");
        int tipo = leerEntero();
        System.out.print("Nombre: ");
        String nom = leerTexto();
        System.out.print("Código: ");
        String cod = leerTexto();
        System.out.print("Créditos: ");
        int cre = leerEntero();
        if (tipo == 1) {
            System.out.print("Semestre: ");
            int sem = leerEntero();
            profesor.getAsignaturas().add(new AsignaturaObligatoria(nom, cod, cre, sem));
        } else {
            System.out.print("Área: ");
            String area = leerTexto();
            profesor.getAsignaturas().add(new AsignaturaElectiva(nom, cod, cre, area));
        }
        System.out.println("Asignatura vinculada al profesor.");
    }

    private void verAsignaturasProfesor(Profesor profesor) {
        if (profesor.getAsignaturas().isEmpty()) {
