    }

    private void editarProfesor(RegistroProfesores registroProfesores) {
        System.out.print("Ingrese ID del profesor a editar: ");
        String id = scanner.nextLine();

        System.out.print("Ingrese nuevo nombre: ");
        String nuevoNombre = scanner.nextLine();

        System.out.print("Ingrese nueva especialidad: ");
        String nuevaEspecialidad = scanner.nextLine();

        boolean editado = registroProfesores.editarProfesor(id, nuevoNombre, nuevaEspecialidad);

        if (editado == true) {
            System.out.println("Profesor editado correctamente.");
        } else {
            System.out.println("No se encuentra el profesor.");
        }
    }

    private void eliminarProfesor(RegistroProfesores registroProfesores) {
        System.out.print("Ingrese ID del profesor a eliminar: ");
        String id = scanner.nextLine();

        boolean eliminado = registroProfesores.eliminarProfesor(id);

        if (eliminado == true) {
            System.out.println("Profesor eliminado correctamente.");
        } else {
            System.out.println("No se encuentra el profesor.");
        }
    }

    private void buscarProfesorPorId(RegistroProfesores registroProfesores) {
        System.out.print("Ingrese ID del profesor: ");
        String id = scanner.nextLine();

        Profesor profesor = registroProfesores.buscarProfesor(id);

        if (profesor != null) {
            profesor.mostrarInfo();
        } else {
            System.out.println("Profesor no encontrado.");
        }
    }

    private void buscarProfesorPorNombre(RegistroProfesores registroProfesores) {
        System.out.print("Ingrese nombre del profesor: ");
        String nombre = scanner.nextLine();

        Profesor profesor = registroProfesores.buscarProfesorPorNombre(nombre);

        if (profesor != null) {
            profesor.mostrarInfo();
        } else {
            System.out.println("Profesor no encontrado.");
        }
    }

    private void mostrarProfesoresPorEspecialidad(RegistroProfesores registroProfesores) {
        System.out.print("Ingrese especialidad: ");
        String especialidad = scanner.nextLine();

        registroProfesores.mostrarProfesoresPorEspecialidad(especialidad);
    }

    private int leerEntero() {
        while (true) {
            try {
                String entrada = scanner.nextLine();
                return Integer.parseInt(entrada);
            } catch (NumberFormatException e) {
                System.out.print("Ingrese un numero válido: ");
            }
        }
    }

    private double leerDouble() {
        while (true) {
            try {
                String entrada = scanner.nextLine();
                return Double.parseDouble(entrada);
            } catch (NumberFormatException e) {
                System.out.print("Ingrese un valor numerico valido: ");
            }
        }
    }
}
