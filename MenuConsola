    /**
     * Solicita y valida la entrada de texto por teclado.
     * Evita que el usuario ingrese campos vacíos o cadenas que contengan únicamente números.
     * 
     * @return Un String validado y sin espacios al inicio o al final.
     */
    private String leerTexto() {
        while (true) {
            String entrada = scanner.nextLine().trim();
            if (entrada.isEmpty()) {
                System.out.print("Error: El campo no puede estar vacio: ");
                continue;
            }
            if (entrada.matches("[0-9]+")) {
                System.out.print("Error: No ingrese solo numeros para un texto: ");
                continue;
            }
            return entrada;
        }
    }

    /**
     * Solicita y valida la entrada de un número entero por teclado.
     * Atrapa excepciones de formato (letras en lugar de números).
     * 
     * @return Un valor entero validado.
     */
    private int leerEntero() {
        while (true) {
            try {
                String entrada = scanner.nextLine();
                return Integer.parseInt(entrada);
            } catch (NumberFormatException e) {
                System.out.print("Error: Ingrese un numero entero valido: ");
            }
        }
    }

    /**
     * Solicita y valida la entrada de un número decimal (Double) por teclado.
     * Atrapa excepciones de formato de número.
     * 
     * @return Un valor double validado.
     */
    private double leerDouble() {
        while (true) {
            try {
                String entrada = scanner.nextLine();
                return Double.parseDouble(entrada);
            } catch (NumberFormatException e) {
                System.out.print("Error: Ingrese un valor numerico valido: ");
            }
        }
    }

