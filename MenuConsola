    /**
     * Limpia visualmente la consola imprimiendo saltos de línea.
     * Diseñado para funcionar de manera estable dentro de entornos IDE como NetBeans.
     */
    private void limpiarPantalla() {
        for (int i = 0; i < 50; i++) {
            System.out.println();
        }
    }

    /**
     * Pausa la ejecución del programa requiriendo que el usuario presione la tecla ENTER.
     * Permite que el usuario tenga tiempo de leer mensajes de éxito o error antes de recargar el menú.
     */
    private void pausar() {
        System.out.println("\n------------------------------------------------");
        System.out.println("Presione ENTER para continuar...");
        scanner.nextLine(); 
    }
