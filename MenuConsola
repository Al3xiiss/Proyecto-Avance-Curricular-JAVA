    private void gestionarAsignaturasProfesor(RegistroProfesores registroProfesores) {
        System.out.print("\nIngrese ID del profesor para gestionar sus asignaturas: ");
        String id = leerTexto();
        Profesor profesor = registroProfesores.getProfesores().get(id);

        if (profesor == null) {
            System.out.println("Error: Profesor no encontrado.");
            return;
        }

        int opcion;
        do {
            System.out.println("\n--- Asignaturas Dictadas Por: " + profesor.getNombre().toUpperCase() + " ---");
            System.out.println("1. Asignar nueva Asignatura");
            System.out.println("2. Ver listado de asignaturas dictadas");
            System.out.println("3. Editar datos de asignatura");
            System.out.println("4. Eliminar asignatura del profesor");
            System.out.println("5. Buscar asignatura específica");
            System.out.println("6. Volver al menu de profesores");
            System.out.print("Seleccione una opcion: ");
            
            opcion = leerEntero();

            switch (opcion) {
                case 1: 
                    System.out.println("\nTipo: 1. Obligatoria | 2. Electiva");
                    int tipo = leerEntero();
                    System.out.print("Nombre: "); String nom = leerTexto();
                    System.out.print("Código: "); String cod = leerTexto();
                    System.out.print("Créditos: "); int cre = leerEntero();

                    if (tipo == 1) {
                        System.out.print("Semestre: "); int sem = leerEntero();
                        profesor.getAsignaturas().add(new AsignaturaObligatoria(nom, cod, cre, sem));
                    } else {
                        System.out.print("Área: "); String area = leerTexto();
                        profesor.getAsignaturas().add(new AsignaturaElectiva(nom, cod, cre, area));
                    }
                    System.out.println("Asignatura vinculada al profesor.");
                    break;

                case 2: 
                    if (profesor.getAsignaturas().isEmpty()) {
                        System.out.println("El profesor no tiene asignaturas a cargo.");
                    } else {
                        for (Asignatura a : profesor.getAsignaturas()) a.mostrarInfo();
                    }
                    break;

                case 3: 
                    System.out.print("Ingrese codigo de la asignatura a editar: ");
                    String codEdit = leerTexto();
                    Asignatura asigEdit = profesor.buscarAsignatura(codEdit);
                    if (asigEdit != null) {
                        System.out.print("Nuevo nombre para la asignatura: ");
                        asigEdit.setNombre(leerTexto());
                        System.out.println("Nombre actualizado.");
                    } else {
                        System.out.println("Asignatura no encontrada.");
                    }
                    break;

                case 4: 
                    System.out.print("Ingrese codigo de la asignatura a quitar: ");
                    String codDel = leerTexto();
                    profesor.eliminarAsignatura(codDel);
                    System.out.println("Asignatura eliminada de la carga academica.");
                    break;

                case 5: 
                    System.out.print("Ingrese codigo de la asignatura a buscar: ");
                    String codBus = leerTexto();
                    Asignatura asigBus = profesor.buscarAsignatura(codBus);
                    if (asigBus != null) {
                        asigBus.mostrarInfo();
                    } else {
                        System.out.println("El profesor no dicta esa asignatura.");
                    }
                    break;
                case 6:
                    System.out.println("Regresando...");
                    break;
            }
        } while (opcion != 6);
    }

    private void gestionarAsignaturasAlumno(RegistroAlumnos registroAlumnos) {
        System.out.print("\nIngrese ID del alumno para gestionar su malla: ");
        String id = leerTexto();
        try {
            // 1. Buscamos al alumno (lanza excepción si no existe)
            Alumno alumno = registroAlumnos.buscarAlumno(id);
            int opcion;
            do {
                System.out.println("\n--- Gestion de Asignaturas del alumno: " + alumno.getNombre().toUpperCase() + " ---");
                System.out.println("1. Agregar Asignatura");
                System.out.println("2. Mostrar Malla Curricular");                            
                System.out.println("3. Modificar Estado/Nota");           
                System.out.println("4. Eliminar Asignatura");           
                System.out.println("5. Buscar Asignatura por Codigo");         
                System.out.println("6. Volver al menu de alumnos");         
                System.out.print("Seleccione una opcion: ");
                      
                opcion = leerEntero();
            
                switch (opcion) {                                  
                    case 1:                   
                        System.out.println("\nTipo de asignatura: 1. Obligatoria | 2. Electiva");                
                        int tipo = leerEntero();                                  
                        System.out.print("Nombre: "); String nom = leerTexto();                    
                        System.out.print("Codigo: "); String cod = leerTexto();                    
                        System.out.print("Creditos: "); int cre = leerEntero();
                    
                        if (tipo == 1) {                     
                            System.out.print("Semestre: "); int sem = leerEntero();                       
                            alumno.getMalla().add(new AsignaturaObligatoria(nom, cod, cre, sem));                   
                        } else {                      
                            System.out.print("Area de interes: "); String area = leerTexto();                       
                            alumno.getMalla().add(new AsignaturaElectiva(nom, cod, cre, area));                   
                        }                 
                        System.out.println("Asignatura agregada con exito.");                  
                        break;              
                    case 2: 
                        if (alumno.getMalla().isEmpty()) {                    
                            System.out.println("La malla se encuentra vacia.");                  
                        } else {                  
                            System.out.println("\n--- Listado de asignaturas ---");                  
                            for (Asignatura a : alumno.getMalla()) {                   
                                a.mostrarInfo();                 
                            }                 
                        }                 
                        break;

               
                    case 3: 
                  
                        System.out.print("Ingrese codigo de la asignatura a modificar: ");
                   
                        String codEdit = leerTexto();
                   
                        try {
                    
                            // 2. Buscamos la asignatura (lanza excepción si no existe)
                    
                            Asignatura asigEdit = alumno.buscarAsignatura(codEdit);
                       
                            System.out.print("¿Se encuentra aprobada? (1: Si | 2: No): ");
                        
                            int estado = leerEntero();
                        
                            asigEdit.setAprobada(estado == 1);
                        
                            System.out.println("Estado actualizado.");
                    
                        } catch (EntidadNoEncontradaException e) {
                        
                            System.out.println(e.getMessage());
                    
                        }
                    
                        break;

                case 4: 
                    System.out.print("Ingrese codigo de la asignatura a eliminar: ");
                    String codDel = leerTexto();
                    try {
                        // 3. Intentamos eliminar (lanza excepción si no existe)
                        alumno.eliminarAsignatura(codDel);
                        System.out.println("Asignatura eliminada correctamente.");
                    } catch (EntidadNoEncontradaException e) {
                        System.out.println(e.getMessage());
                    }
                    break;

                case 5: 
                    System.out.print("Ingrese codigo de la asignatura a buscar: ");
                    String codBus = leerTexto();
                    try {
                        Asignatura asigBus = alumno.buscarAsignatura(codBus);
                        System.out.println("\n--- RESULTADO DE BUSQUEDA ---");
                        asigBus.mostrarInfo();
                    } catch (EntidadNoEncontradaException e) {
                        System.out.println(e.getMessage());
                    }
                    break;

                case 6:
                    System.out.println("Regresando...");
                    break;

                default:
                    System.out.println("Opcion no valida.");
            }
        } while (opcion != 6);

    } catch (EntidadNoEncontradaException e) {
        // Este catch atrapa el error inicial si el ID del Alumno no existe
        System.out.println(e.getMessage());
    }
}

