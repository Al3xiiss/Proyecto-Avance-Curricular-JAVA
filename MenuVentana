        }

        String e = JOptionPane.showInputDialog("Nueva Especialidad:");
        if (e == null) {
            return;
        }

        try {
            registroProfesores.editarProfesor(id, n, e);
            JOptionPane.showMessageDialog(null, "Datos actualizados correctamente.");
        } catch (EntidadNoEncontradaException | AtributoInvalidoException ex) { // ATRAPAMOS AMBAS EXCEPCIONES AQUÍ
            JOptionPane.showMessageDialog(null, ex.getMessage(), "Error de validación", JOptionPane.ERROR_MESSAGE);
        }
    }

    private void eliminarProfesor(RegistroProfesores registroProfesores) {
        String id = JOptionPane.showInputDialog("Ingrese ID del profesor a eliminar:");
        if (id == null) {
            return;
        }
        try {
            // La lógica ahora es void y lanza excepción si falla
            registroProfesores.eliminarProfesor(id);
            JOptionPane.showMessageDialog(null, "Profesor eliminado del sistema.");
        } catch (EntidadNoEncontradaException e) {
            // Capturamos el error enviado desde la lógica y lo mostramos como mensaje de error
            JOptionPane.showMessageDialog(null, e.getMessage(), "Error de Eliminación", JOptionPane.ERROR_MESSAGE);
        }
    }

    private void buscarProfesorPorId(RegistroProfesores registroProfesores) {
        String id = JOptionPane.showInputDialog("Ingrese ID a buscar:");

        // Si el usuario presiona "Cancelar"
        if (id == null || id.trim().isEmpty()) {
            return;
        }
        try {
            // Intentamos buscar al profesor
            Profesor p = registroProfesores.buscarProfesor(id);

            // Si no lanzó la excepción, es porque lo encontró
            JOptionPane.showMessageDialog(null, formatearProfesor(p), "Resultado de Búsqueda", JOptionPane.INFORMATION_MESSAGE);

        } catch (EntidadNoEncontradaException e) {
            // Capturamos el error si el ID no existe (SIA-12)
            JOptionPane.showMessageDialog(null, e.getMessage(), "Error de Búsqueda", JOptionPane.ERROR_MESSAGE);
        }
    }

    private void buscarProfesorPorNombre(RegistroProfesores registroProfesores) {
        String n = JOptionPane.showInputDialog("Ingrese nombre completo:");
        // Si el usuario cancela la entrada
        if (n == null || n.trim().isEmpty()) {
            return;
        }
        try {
            Profesor p = registroProfesores.buscarProfesorPorNombre(n);
            // Si lo encuentra, mostramos la info formateada
            JOptionPane.showMessageDialog(null,
                    formatearProfesor(p),
                    "Resultado de Búsqueda",
                    JOptionPane.INFORMATION_MESSAGE);
        } catch (EntidadNoEncontradaException e) {
            // Si no lo encuentra, mostramos el mensaje de la excepción     
            JOptionPane.showMessageDialog(null,
                    e.getMessage(),
                    "Sin Resultados",
                    JOptionPane.WARNING_MESSAGE);
        }
    }

    private void mostrarProfesoresPorEspecialidad(RegistroProfesores registroProfesores) {
        String esp = JOptionPane.showInputDialog("Especialidad:");
        String texto = "Profesores de " + esp + ":\n";
        for (Profesor p : registroProfesores.getProfesores().values()) {
            if (p.getEspecialidad().equalsIgnoreCase(esp)) {
                texto += "- " + p.getNombre() + "\n";
            }
        }
        mostrarMensaje("ESPECIALIDAD", texto);
    }

    // ==========================================================
    // UTILIDADES
    // ==========================================================
    private int leerEntero(String entrada) {
        try {
            return Integer.parseInt(entrada);
        } catch (Exception e) {
            return -1;
        }
    }

    private void mostrarMensaje(String titulo, String contenido) {
        // 1. Creamos un área de texto donde irá el listado
        JTextArea textArea = new JTextArea(20, 50); // 20 filas de alto
        textArea.setText(contenido);
        textArea.setEditable(false); // Para que no puedan editar el listado
        textArea.setLineWrap(true);  // Ajuste de línea automático
        textArea.setWrapStyleWord(true);
        textArea.setCaretPosition(0); // Para que siempre empiece arriba de todo
        // 2. Metemos esa área de texto dentro de un JScrollPane (la barrita)
        JScrollPane scrollPane = new JScrollPane(textArea);
        // 3. Mostramos el scrollPane en lugar del texto plano
        JOptionPane.showMessageDialog(null, scrollPane, titulo, JOptionPane.INFORMATION_MESSAGE);
    }

    private String obtenerListadoAlumnos(RegistroAlumnos registroAlumnos) {
        if (registroAlumnos.getAlumnos().isEmpty()) {
            return "No hay alumnos.";
        }
        String t = "";
        for (Alumno a : registroAlumnos.getAlumnos().values()) {
            t += formatearAlumno(a) + "\n";
        }
        return t;
    }

    private String obtenerListadoProfesores(RegistroProfesores registroProfesores) {
        if (registroProfesores.getProfesores().isEmpty()) {
            return "No hay profesores.";
        }
        String t = "";
        for (Profesor p : registroProfesores.getProfesores().values()) {
            t += formatearProfesor(p) + "\n";
        }
        return t;
    }

    private String formatearAlumno(Alumno alumno) {
        return "ID: " + alumno.getId() + " | Nombre: " + alumno.getNombre()
                + "\nCarrera: " + alumno.getCarrera() + " | Progreso: " + String.format("%.2f", alumno.calcularProgreso()) + "%"
                + "\n-----------------------------";
    }

    private String formatearProfesor(Profesor profesor) {
        return "ID: " + profesor.getId() + " | Nombre: " + profesor.getNombre()
                + "\nEspecialidad: " + profesor.getEspecialidad() + " | Asignaturas: " + profesor.getAsignaturas().size()
                + "\n-----------------------------";
    }
