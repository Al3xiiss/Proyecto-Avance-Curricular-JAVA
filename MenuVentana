    private void mostrarProfesoresPorEspecialidad(RegistroProfesores registroProfesores) {
        String esp = JOptionPane.showInputDialog("Especialidad:");
        String texto = "Profesores de " + esp + ":\n";
        for (Profesor p : registroProfesores.getProfesores().values()) {
            if (p.getEspecialidad().equalsIgnoreCase(esp)) texto += "- " + p.getNombre() + "\n";
        }
        mostrarMensaje("ESPECIALIDAD", texto);
    }

    // ==========================================================
    // UTILIDADES
