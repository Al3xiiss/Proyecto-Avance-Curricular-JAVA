    private void buscarProfesorPorId(RegistroProfesores registroProfesores) {
        String id = JOptionPane.showInputDialog("Ingrese ID del profesor:");
        if (id == null) return;

        Profesor profesor = registroProfesores.buscarProfesor(id);

        if (profesor != null) {
            JOptionPane.showMessageDialog(null, formatearProfesor(profesor));
        } else {
            JOptionPane.showMessageDialog(null, "Profesor no encontrado.");
        }
    }

    private void buscarProfesorPorNombre(RegistroProfesores registroProfesores) {
        String nombre = JOptionPane.showInputDialog("Ingrese nombre del profesor:");
        if (nombre == null) return;

        Profesor profesor = registroProfesores.buscarProfesorPorNombre(nombre);

        if (profesor != null) {
            JOptionPane.showMessageDialog(null, formatearProfesor(profesor));
        } else {
            JOptionPane.showMessageDialog(null, "Profesor no encontrado.");
        }
    }

    private void mostrarProfesoresPorEspecialidad(RegistroProfesores registroProfesores) {
        String especialidad = JOptionPane.showInputDialog("Ingrese especialidad:");
        if (especialidad == null) return;

        JOptionPane.showMessageDialog(null,
                "Revisar consola para ver el listado de profesores por especialidad.");
        registroProfesores.mostrarProfesoresPorEspecialidad(especialidad);
    }

    private int leerEntero(String entrada) {
        try {
            return Integer.parseInt(entrada);
        } catch (NumberFormatException e) {
            return -1;
        }
    }

    private void mostrarMensaje(String titulo, String contenido) {
        JOptionPane.showMessageDialog(null, contenido, titulo, JOptionPane.INFORMATION_MESSAGE);
    }

    private String obtenerListadoAlumnos(RegistroAlumnos registroAlumnos) {
        if (registroAlumnos.getAlumnos().isEmpty()) {
            return "No hay alumnos registrados.";
        }

        String texto = "";
        for (Alumno alumno : registroAlumnos.getAlumnos().values()) {
            texto += formatearAlumno(alumno) + "\n";
        }

        return texto;
    }

    private String obtenerListadoProfesores(RegistroProfesores registroProfesores) {
        if (registroProfesores.getProfesores().isEmpty()) {
            return "No hay profesores registrados.";
        }

        String texto = "";
        for (Profesor profesor : registroProfesores.getProfesores().values()) {
            texto += formatearProfesor(profesor) + "\n";
        }

        return texto;
    }

    private String formatearAlumno(Alumno alumno) {
        String texto = "";
        texto += "ID: " + alumno.getId() + "\n";
        texto += "Nombre: " + alumno.getNombre() + "\n";
        texto += "Carrera: " + alumno.getCarrera() + "\n";
        texto += "Progreso: " + alumno.calcularProgreso() + "%\n";
        texto += "Asignaturas inscritas: " + alumno.getMalla().size() + "\n";
        texto += "-----------------------------";
        return texto;
    }

    private String formatearProfesor(Profesor profesor) {
        String texto = "";
        texto += "ID: " + profesor.getId() + "\n";
        texto += "Nombre: " + profesor.getNombre() + "\n";
        texto += "Especialidad: " + profesor.getEspecialidad() + "\n";
        texto += "Cantidad de asignaturas: " + profesor.getAsignaturas().size() + "\n";
        texto += "-----------------------------";
        return texto;
    }
}
