    private void gestionarAsignaturasAlumno(RegistroAlumnos registroAlumnos) {
        String id = JOptionPane.showInputDialog("Ingrese ID del alumno para gestionar su malla:");
    
        if (id == null) return;

   
        try {
     
            // Buscamos al alumno (lanza excepción si no existe)
      
            Alumno alumno = registroAlumnos.buscarAlumno(id);
        
       
            int opcion;
        
            do {
       
                String menu = "Gestion de Asignaturas - Alumno: " + alumno.getNombre().toUpperCase() + "\n" +
         
                        "1. Agregar Asignatura\n" +
          
                        "2. Mostrar Malla Curricular\n" +
            
                        "3. Modificar Estado (Aprobada/Pendiente)\n" +
            
                        "4. Eliminar Asignatura\n" +
            
                        "5. Buscar Asignatura por Codigo\n" +
             
                        "6. Volver";
            
           
                String entrada = JOptionPane.showInputDialog(null, menu);
            
                if (entrada == null) break;
           
                opcion = leerEntero(entrada);

           
                switch (opcion) {
             
                    case 1: // Agregar Asignatura
                 
                        agregarAsignaturaMalla(alumno);
                    break;

                case 2: // Mostrar Malla
                    mostrarMalla(alumno);
                    break;

                case 3: // Modificar Estado (SIA-12)
                    String codEdit = JOptionPane.showInputDialog("Ingrese codigo de la asignatura:");
                    if (codEdit == null) break;
                    try {
                        Asignatura asig = alumno.buscarAsignatura(codEdit);
                        int r = JOptionPane.showConfirmDialog(null, "¿Esta aprobada?", "Estado", JOptionPane.YES_NO_OPTION);
                        asig.setAprobada(r == JOptionPane.YES_OPTION);
                        JOptionPane.showMessageDialog(null, "Estado actualizado.");
                    } catch (EntidadNoEncontradaException e) {
                        JOptionPane.showMessageDialog(null, e.getMessage());
                    }
                    break;

                case 4: // Eliminar Asignatura (SIA-12)
                    String codDel = JOptionPane.showInputDialog("Codigo a eliminar:");
                    if (codDel == null) break;
                    try {
                        alumno.eliminarAsignatura(codDel);
                        JOptionPane.showMessageDialog(null, "Asignatura eliminada correctamente.");
                    } catch (EntidadNoEncontradaException e) {
                        JOptionPane.showMessageDialog(null, e.getMessage());
                    }
                    break;

                case 5: // Buscar por Código (SIA-12)
                    String codBus = JOptionPane.showInputDialog("Codigo a buscar:");
                    if (codBus == null) break;
                    try {
                        Asignatura b = alumno.buscarAsignatura(codBus);
                        JOptionPane.showMessageDialog(null, "Nombre: " + b.getNombre() + "\nCreditos: " + b.getCreditos());
                    } catch (EntidadNoEncontradaException e) {
                        JOptionPane.showMessageDialog(null, e.getMessage());
                    }
                    break;
            }
        } while (opcion != 6);

    } catch (EntidadNoEncontradaException e) {
        // Este catch atrapa si el Alumno inicial no fue encontrado
        JOptionPane.showMessageDialog(null, e.getMessage(), "Error", JOptionPane.ERROR_MESSAGE);
    }
}

    private void agregarAsignaturaMalla(Alumno alumno) {
        String tipo = JOptionPane.showInputDialog("Tipo de asignatura:\n1. Obligatoria\n2. Electiva");
        if (tipo == null) return;
        
        String nom = JOptionPane.showInputDialog("Nombre de la asignatura:");
        if (nom == null) return;
    
        String cod = JOptionPane.showInputDialog("Codigo:");    
        if (cod == null) return;

        // Usamos el método auxiliar leerEntero para manejar errores de formato
        int cre = leerEntero(JOptionPane.showInputDialog("Creditos:"));
        if (tipo.equals("1")) {
            int sem = leerEntero(JOptionPane.showInputDialog("Semestre (1-10):"));
            // Se agrega directamente a la lista del objeto alumno
            alumno.getMalla().add(new AsignaturaObligatoria(nom, cod, cre, sem));
       } else {
            String area = JOptionPane.showInputDialog("Area de interes:");
            if (area == null) return;
            alumno.getMalla().add(new AsignaturaElectiva(nom, cod, cre, area));
        }
        JOptionPane.showMessageDialog(null, "Asignatura agregada con exito a la malla de " + alumno.getNombre());
    }
    private void mostrarMalla(Alumno alumno) {
        if (alumno.getMalla().isEmpty()) {
            JOptionPane.showMessageDialog(null, "La malla se encuentra vacía.", "Malla Curricular", JOptionPane.INFORMATION_MESSAGE);
            return;
        }
        StringBuilder reporte = new StringBuilder();
        reporte.append("--- LISTADO DE ASIGNATURAS ---\n");
        reporte.append("Alumno: ").append(alumno.getNombre()).append("\n\n");
        for (Asignatura a : alumno.getMalla()) {
            // Como mostrarInfo() en tus subclases probablemente solo imprime en consola,
            // aquí construiremos el texto equivalente para la ventana:
            reporte.append("Código: ").append(a.getCodigo()).append("\n")
               .append("Nombre: ").append(a.getNombre()).append("\n")
               .append("Créditos: ").append(a.getCreditos()).append("\n")
               .append("Estado: ").append(a.isAprobada() ? "Aprobada" : "Pendiente").append("\n");
            // Aquí aplicamos el polimorfismo para los datos que sobreescribiste
            if (a instanceof AsignaturaObligatoria) {
                AsignaturaObligatoria ob = (AsignaturaObligatoria) a;
                reporte.append("Tipo: Obligatoria\n")
                   .append("Semestre: ").append(ob.getSemestre()).append("\n");
            } else if (a instanceof AsignaturaElectiva) {
                
                AsignaturaElectiva el = (AsignaturaElectiva) a;
                reporte.append("Tipo: Electiva\n")
                   .append("Área: ").append(el.getArea()).append("\n");
            }
            reporte.append("----------------------------------\n");
        }
        // Usamos un JTextArea dentro del Scroll por si el alumno tiene muchas materias
        JTextArea textArea = new JTextArea(reporte.toString());
        textArea.setEditable(false);
        JScrollPane scrollPane = new JScrollPane(textArea);
        scrollPane.setPreferredSize(new java.awt.Dimension(400, 300));
        JOptionPane.showMessageDialog(null, scrollPane, "Malla Curricular", JOptionPane.PLAIN_MESSAGE);
    }
    private void gestionarAsignaturasProfesor(RegistroProfesores registroProfesores) {
        String id = JOptionPane.showInputDialog("Ingrese ID del profesor:");
        if (id == null) return;

        Profesor prof = registroProfesores.getProfesores().get(id);
        if (prof == null) {
            JOptionPane.showMessageDialog(null, "Error: Profesor no encontrado.");
            return;
        }

        int opcion;
        do {
            String menu = "Asignaturas Dictadas - Prof: " + prof.getNombre().toUpperCase() + "\n" +
                          "1. Asignar nueva Asignatura\n" +
                          "2. Ver listado dictado\n" +
                          "3. Editar nombre de asignatura\n" +
                          "4. Eliminar asignatura\n" +
                          "5. Volver";
            
            String entrada = JOptionPane.showInputDialog(null, menu);
            if (entrada == null) break;
            opcion = leerEntero(entrada);

            switch (opcion) {
                case 1:
                    String nom = JOptionPane.showInputDialog("Nombre:");
                    String cod = JOptionPane.showInputDialog("Codigo:");
                    int cre = leerEntero(JOptionPane.showInputDialog("Creditos:"));
                    prof.getAsignaturas().add(new AsignaturaObligatoria(nom, cod, cre, 1));
                    JOptionPane.showMessageDialog(null, "Vinculada al profesor.");
                    break;
                case 2:
                    String lista = "Asignaturas a cargo:\n";
                    for (Asignatura a : prof.getAsignaturas()) lista += "- " + a.getNombre() + "\n";
                    JOptionPane.showMessageDialog(null, lista);
                    break;
                case 3:
                    String codEd = JOptionPane.showInputDialog("Codigo:");
                    Asignatura ae = prof.buscarAsignatura(codEd);
                    if (ae != null) {
                        ae.setNombre(JOptionPane.showInputDialog("Nuevo nombre:"));
                        JOptionPane.showMessageDialog(null, "Actualizado.");
                    }
                    break;
                case 4:
                    String codDe = JOptionPane.showInputDialog("Codigo:");
                    prof.eliminarAsignatura(codDe);
                    JOptionPane.showMessageDialog(null, "Eliminada.");
                    break;
            }
        } while (opcion != 5);
    }

