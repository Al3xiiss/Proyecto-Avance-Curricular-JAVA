/**
 * Clase encargada de gestionar la Interfaz de Usuario Gráfica (GUI) mediante ventanas emergentes.
 * Utiliza la librería Swing (JOptionPane) para capturar datos, mostrar menús y 
 * desplegar resultados o errores, actuando como intermediaria con la lógica de negocio.
 */
public class MenuVentana {

    /**
     * Muestra el menú principal de la aplicación en una ventana emergente y gestiona el flujo inicial.
     * 
     * @param registroAlumnos Gestor en memoria de la base de datos de alumnos.
     * @param registroProfesores Gestor en memoria de la base de datos de profesores.
     */
    public void mostrarMenu(RegistroAlumnos registroAlumnos, RegistroProfesores registroProfesores) {
        int opcion;

        do {
            String entrada = JOptionPane.showInputDialog(
                    null,
                    "========== MENU PRINCIPAL ==========\n"
                    + "1. Gestionar alumnos\n"
                    + "2. Gestionar profesores\n"
                    + "3. Salir\n"
                    + "Seleccione una opcion:",
                    "Sistema Academico",
                    JOptionPane.QUESTION_MESSAGE
            );

            // Manejo de la cancelación de la ventana
            if (entrada == null) {
                JOptionPane.showMessageDialog(null, "La aplicacion fue cerrada.");
                return;
            }

            opcion = leerEntero(entrada);

            switch (opcion) {
                case 1:
                    menuAlumnos(registroAlumnos);
                    break;
                case 2:
                    menuProfesores(registroProfesores);
                    break;
                case 3:
                    JOptionPane.showMessageDialog(null, "Saliendo del sistema...");
                    break;
                default:
                    JOptionPane.showMessageDialog(null, "Opcion invalida.");
            }

        } while (opcion != 3);
    }

