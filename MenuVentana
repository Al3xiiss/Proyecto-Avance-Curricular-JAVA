    /**
     * Captura datos mediante GUI para instanciar y registrar un nuevo alumno.
     * @param registroAlumnos Gestor encargado de la inserción.
     */
    private void agregarAlumno(RegistroAlumnos registroAlumnos) {
        String id = JOptionPane.showInputDialog("Ingrese ID del alumno:");
        if (id == null) return;

        String nombre = JOptionPane.showInputDialog("Ingrese nombre del alumno:");
        if (nombre == null) return;

        String carrera = JOptionPane.showInputDialog("Ingrese carrera del alumno:");
        if (carrera == null) return;

        try {
            registroAlumnos.agregarAlumno(id, nombre, carrera);
            JOptionPane.showMessageDialog(null, "Alumno agregado correctamente.");
        } catch (AtributoInvalidoException e) {
            JOptionPane.showMessageDialog(null, e.getMessage(), "Error de Registro", JOptionPane.ERROR_MESSAGE);
        }
    }

    /**
     * Captura datos para actualizar la información básica de un alumno existente.
     * @param registroAlumnos Gestor para buscar y procesar la actualización.
     */
    private void editarAlumno(RegistroAlumnos registroAlumnos) {
        String id = JOptionPane.showInputDialog("ID del alumno a editar:");
        if (id == null || id.trim().isEmpty()) return;

        String n = JOptionPane.showInputDialog("Nuevo nombre:");
        if (n == null) return;

        String c = JOptionPane.showInputDialog("Nueva carrera:");
        if (c == null) return;

        try {
            registroAlumnos.editarAlumno(id, n, c);
            JOptionPane.showMessageDialog(null, "Alumno editado correctamente.");
        } catch (EntidadNoEncontradaException | AtributoInvalidoException e) { 
            JOptionPane.showMessageDialog(null, e.getMessage(), "Error de validación", JOptionPane.ERROR_MESSAGE);
        }
    }

    /**
     * Remueve a un alumno del sistema tras solicitar su identificador.
     * @param registroAlumnos Gestor encargado de la eliminación.
     */
    private void eliminarAlumno(RegistroAlumnos registroAlumnos) {
        String id = JOptionPane.showInputDialog("ID del alumno a eliminar:");
        if (id == null || id.trim().isEmpty()) return;
        
        try {
            registroAlumnos.eliminarAlumno(id);
            JOptionPane.showMessageDialog(null, "Alumno eliminado correctamente.");
        } catch (EntidadNoEncontradaException e) {
            JOptionPane.showMessageDialog(null, e.getMessage(), "Error de Eliminación", JOptionPane.ERROR_MESSAGE);
        }
    }

    /**
     * Muestra la información formateada de un alumno localizado por su ID.
     * @param registroAlumnos Gestor en el cual realizar la búsqueda.
     */
    private void buscarAlumnoPorId(RegistroAlumnos registroAlumnos) {
        String id = JOptionPane.showInputDialog("Ingrese el ID del alumno a buscar:");
        if (id == null || id.trim().isEmpty()) return;
        
        try {
            Alumno a = registroAlumnos.buscarAlumno(id);
            JOptionPane.showMessageDialog(null, formatearAlumno(a), "Detalles del Alumno", JOptionPane.INFORMATION_MESSAGE);
        } catch (EntidadNoEncontradaException e) {
            JOptionPane.showMessageDialog(null, e.getMessage(), "Resultado de búsqueda", JOptionPane.WARNING_MESSAGE);
        }
    }

    /**
     * Busca y muestra los detalles de un alumno mediante coincidencia de nombre y carrera.
     * @param registroAlumnos Gestor en el cual realizar la búsqueda.
     */
    private void buscarAlumnoPorNombreYCarrera(RegistroAlumnos registroAlumnos) {
        String n = JOptionPane.showInputDialog("Nombre:");
        if (n == null) return;
        String c = JOptionPane.showInputDialog("Carrera:");
        if (c == null) return;

        try {
            Alumno a = registroAlumnos.buscarAlumno(n, c);
            JOptionPane.showMessageDialog(null, formatearAlumno(a), "Resultado de Búsqueda", JOptionPane.INFORMATION_MESSAGE);
        } catch (EntidadNoEncontradaException e) {
            JOptionPane.showMessageDialog(null, e.getMessage(), "Aviso", JOptionPane.WARNING_MESSAGE);
        }
    }

    /**
     * Recopila y muestra en ventana el listado de alumnos cuyo progreso es menor al indicado.
     * @param registroAlumnos Gestor que provee la funcionalidad de filtro.
     */
    private void mostrarAlumnosEnRiesgo(RegistroAlumnos registroAlumnos) {
        String v = JOptionPane.showInputDialog("Porcentaje minimo (ej: 50):");
        if (v == null) return;
        
        double p = Double.parseDouble(v);
        List<Alumno> lista = registroAlumnos.obtenerAlumnosEnRiesgo(p);
        String texto = "ALUMNOS CON PROGRESO MENOR A " + p + "%\n";
        
        for (Alumno a : lista) {
            texto += "- " + a.getNombre() + " (" + a.calcularProgreso() + "%)\n";
        }
        mostrarMensaje("RIESGO ACADEMICO", texto);
    }

    /**
     * Captura datos para instanciar y registrar un nuevo profesor en el sistema.
     * @param registroProfesores Gestor encargado de la inserción.
     */
    private void agregarProfesor(RegistroProfesores registroProfesores) {
        String id = JOptionPane.showInputDialog("Ingrese ID del profesor:");
        if (id == null) return;

        String nombre = JOptionPane.showInputDialog("Ingrese nombre del profesor:");
        if (nombre == null) return;

        String especialidad = JOptionPane.showInputDialog("Ingrese especialidad:");
        if (especialidad == null) return;

        try {
            registroProfesores.agregarProfesor(id, nombre, especialidad);
            JOptionPane.showMessageDialog(null, "Profesor registrado exitosamente.");
        } catch (AtributoInvalidoException e) {
            JOptionPane.showMessageDialog(null, e.getMessage(), "Error al registrar", JOptionPane.ERROR_MESSAGE);
        }
    }

    /**
     * Actualiza la información básica de un profesor mediante su ID.
     * @param registroProfesores Gestor necesario para aplicar los cambios.
     */
    private void editarProfesor(RegistroProfesores registroProfesores) {
        String id = JOptionPane.showInputDialog("Ingrese ID del profesor a editar:");
        if (id == null || id.trim().isEmpty()) return;

        String n = JOptionPane.showInputDialog("Nuevo Nombre:");
        if (n == null) return;

        String e = JOptionPane.showInputDialog("Nueva Especialidad:");
        if (e == null) return;

        try {
            registroProfesores.editarProfesor(id, n, e);
            JOptionPane.showMessageDialog(null, "Datos actualizados correctamente.");
        } catch (EntidadNoEncontradaException | AtributoInvalidoException ex) { 
            JOptionPane.showMessageDialog(null, ex.getMessage(), "Error de validación", JOptionPane.ERROR_MESSAGE);
        }
    }

    /**
     * Elimina un profesor del registro mediante su identificador.
     * @param registroProfesores Gestor que procesará la baja.
     */
    private void eliminarProfesor(RegistroProfesores registroProfesores) {
        String id = JOptionPane.showInputDialog("Ingrese ID del profesor a eliminar:");
        if (id == null) return;
        
        try {
            registroProfesores.eliminarProfesor(id);
            JOptionPane.showMessageDialog(null, "Profesor eliminado del sistema.");
        } catch (EntidadNoEncontradaException e) {
            JOptionPane.showMessageDialog(null, e.getMessage(), "Error de Eliminación", JOptionPane.ERROR_MESSAGE);
        }
    }

    /**
     * Localiza y muestra la información de un profesor buscando por su ID.
     * @param registroProfesores Gestor que realizará la búsqueda.
     */
    private void buscarProfesorPorId(RegistroProfesores registroProfesores) {
        String id = JOptionPane.showInputDialog("Ingrese ID a buscar:");
        if (id == null || id.trim().isEmpty()) return;
        
        try {
            Profesor p = registroProfesores.buscarProfesor(id);
            JOptionPane.showMessageDialog(null, formatearProfesor(p), "Resultado de Búsqueda", JOptionPane.INFORMATION_MESSAGE);
        } catch (EntidadNoEncontradaException e) {
            JOptionPane.showMessageDialog(null, e.getMessage(), "Error de Búsqueda", JOptionPane.ERROR_MESSAGE);
        }
    }

    /**
     * Localiza y muestra a un profesor utilizando su nombre completo.
     * @param registroProfesores Gestor que realizará la búsqueda.
     */
    private void buscarProfesorPorNombre(RegistroProfesores registroProfesores) {
        String n = JOptionPane.showInputDialog("Ingrese nombre completo:");
        if (n == null || n.trim().isEmpty()) return;
        
        try {
            Profesor p = registroProfesores.buscarProfesorPorNombre(n);
            JOptionPane.showMessageDialog(null, formatearProfesor(p), "Resultado de Búsqueda", JOptionPane.INFORMATION_MESSAGE);
        } catch (EntidadNoEncontradaException e) {
            JOptionPane.showMessageDialog(null, e.getMessage(), "Sin Resultados", JOptionPane.WARNING_MESSAGE);
        }
    }

    /**
     * Imprime un listado de profesores que comparten una misma área de especialidad.
     * @param registroProfesores Gestor responsable de ejecutar el filtro.
     */
    private void mostrarProfesoresPorEspecialidad(RegistroProfesores registroProfesores) {
        String esp = JOptionPane.showInputDialog("Especialidad:");
        if (esp == null || esp.trim().isEmpty()) return;

        List<Profesor> lista = registroProfesores.obtenerProfesoresPorEspecialidad(esp);

        if (lista.isEmpty()) {
            JOptionPane.showMessageDialog(null, "No se encontraron profesores con la especialidad: " + esp, "Información", JOptionPane.INFORMATION_MESSAGE);
            return;
        }

        String texto = "Profesores de " + esp + ":\n";
        for (Profesor p : lista) {
            texto += "- " + p.getNombre() + "\n";
        }
        mostrarMensaje("ESPECIALIDAD", texto);
    }

    /**
     * Solicita una carrera y muestra un panel estadístico con el promedio de avance de sus alumnos.
     * @param registroAlumnos Gestor que realiza el procesamiento de los datos académicos.
     */
    private void analizarRendimientoCarrera(RegistroAlumnos registroAlumnos) {
        String carrera = JOptionPane.showInputDialog(null, "Ingrese el nombre de la carrera a analizar (ej. Ingenieria en Sistemas):", JOptionPane.QUESTION_MESSAGE);
        
        if (carrera == null || carrera.trim().isEmpty()) return;

        try {
            double promedioGlobal = registroAlumnos.calcularRendimientoPromedioCarrera(carrera);

            if (promedioGlobal == 0.0) {
                JOptionPane.showMessageDialog(null, "No hay datos suficientes o no existen alumnos registrados en la carrera: " + carrera, "Resultado de Análisis", JOptionPane.INFORMATION_MESSAGE);
            } else {
                String reporte = "KPI DE RENDIMIENTO ACADÉMICO\n"
                               + "Carrera analizada: " + carrera.toUpperCase() + "\n"
                               + "Avance curricular promedio: " + String.format("%.2f", promedioGlobal) + "%";
                
                JOptionPane.showMessageDialog(null, reporte, "Inteligencia de Negocios", JOptionPane.INFORMATION_MESSAGE);
            }
        } catch (AtributoInvalidoException e) {
            JOptionPane.showMessageDialog(null, e.getMessage(), "Error en el Análisis", JOptionPane.ERROR_MESSAGE);
        }
    }

