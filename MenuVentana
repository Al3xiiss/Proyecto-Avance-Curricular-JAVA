    private int leerEntero(String entrada) {
        try {
            return Integer.parseInt(entrada);
        } catch (Exception e) {
            return -1;
        }
    }

    private void mostrarMensaje(String titulo, String contenido) {
        // 1. Creamos un área de texto donde irá el listado
        JTextArea textArea = new JTextArea(20, 50); // 20 filas de alto
        textArea.setText(contenido);
        textArea.setEditable(false); // Para que no puedan editar el listado
        textArea.setLineWrap(true);  // Ajuste de línea automático
        textArea.setWrapStyleWord(true);
        textArea.setCaretPosition(0); // Para que siempre empiece arriba de todo
        // 2. Metemos esa área de texto dentro de un JScrollPane (la barrita)
        JScrollPane scrollPane = new JScrollPane(textArea);
        // 3. Mostramos el scrollPane en lugar del texto plano
        JOptionPane.showMessageDialog(null, scrollPane, titulo, JOptionPane.INFORMATION_MESSAGE);
    }

    private String obtenerListadoAlumnos(RegistroAlumnos registroAlumnos) {
        if (registroAlumnos.getAlumnos().isEmpty()) return "No hay alumnos.";
        String t = "";
        for (Alumno a : registroAlumnos.getAlumnos().values()) t += formatearAlumno(a) + "\n";
        return t;
    }

    private String obtenerListadoProfesores(RegistroProfesores registroProfesores) {
        if (registroProfesores.getProfesores().isEmpty()) return "No hay profesores.";
        String t = "";
        for (Profesor p : registroProfesores.getProfesores().values()) t += formatearProfesor(p) + "\n";
        return t;
    }

    private String formatearAlumno(Alumno alumno) {
        return "ID: " + alumno.getId() + " | Nombre: " + alumno.getNombre() + 
               "\nCarrera: " + alumno.getCarrera() + " | Progreso: " + String.format("%.2f", alumno.calcularProgreso()) + "%" +
               "\n-----------------------------";
    }

    private String formatearProfesor(Profesor profesor) {
        return "ID: " + profesor.getId() + " | Nombre: " + profesor.getNombre() + 
               "\nEspecialidad: " + profesor.getEspecialidad() + " | Asignaturas: " + profesor.getAsignaturas().size() +
               "\n-----------------------------";
    }
