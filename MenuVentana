    private void agregarAlumno(RegistroAlumnos registroAlumnos) {
        // 1. Pedir primero el ID
        String id = JOptionPane.showInputDialog("Ingrese ID del alumno:");

        // Si el usuario presiona "Cancelar" o cierra la ventana
        if (id == null) {
            return;
        }

        // 2. VERIFICACIÓN INMEDIATA:
        // Buscamos si el ID ya está registrado en el Mapa de alumnos
        if (registroAlumnos.getAlumnos().containsKey(id)) {
            JOptionPane.showMessageDialog(null,
                    "Error: Ya existe un alumno con el ID " + id + ".\nVolviendo al menú...",
                    "ID Duplicado",
                    JOptionPane.ERROR_MESSAGE);
            return; // Corta la ejecución del método y vuelve al menú
        }

        // 3. Si el ID no existe, pedimos el resto de los datos
        String nombre = JOptionPane.showInputDialog("Ingrese nombre del alumno:");
        if (nombre == null) {
            return;
        }

        String carrera = JOptionPane.showInputDialog("Ingrese carrera del alumno:");
        if (carrera == null) {
            return;
        }

        // 4. Agregamos al alumno (usando la sobrecarga que ya tienes)
        boolean agregado = registroAlumnos.agregarAlumno(id, nombre, carrera);

        if (agregado) {
            JOptionPane.showMessageDialog(null, "Alumno agregado correctamente.");
        } else {
            JOptionPane.showMessageDialog(null, "No se pudo agregar el alumno.");
        }
    }

    private void editarAlumno(RegistroAlumnos registroAlumnos) {
        String id = JOptionPane.showInputDialog("ID del alumno a editar:");
        if (id == null || id.trim().isEmpty()) {
            return;
        }

        String n = JOptionPane.showInputDialog("Nuevo nombre:");
        if (n == null) {
            return;
        }

        String c = JOptionPane.showInputDialog("Nueva carrera:");
        if (c == null) {
            return;
        }

        try {
            registroAlumnos.editarAlumno(id, n, c);
            JOptionPane.showMessageDialog(null, "Alumno editado correctamente.");

        } catch (EntidadNoEncontradaException | AtributoInvalidoException e) { // ATRAPAMOS AMBAS EXCEPCIONES AQUÍ
            JOptionPane.showMessageDialog(null, e.getMessage(), "Error de validación", JOptionPane.ERROR_MESSAGE);
        }
    }

    private void eliminarAlumno(RegistroAlumnos registroAlumnos) {
        String id = JOptionPane.showInputDialog("ID del alumno a eliminar:");
        // Si el usuario presiona "Cancelar" o cierra la ventana
        if (id == null || id.trim().isEmpty()) {
            return;
        }
        try {
            // La lógica en RegistroAlumnos ahora es 'void' y lanza la excepción si falla
            registroAlumnos.eliminarAlumno(id);
            // Si el código llega aquí, la eliminación fue exitosa
            JOptionPane.showMessageDialog(null, "Alumno eliminado correctamente.");
        } catch (EntidadNoEncontradaException e) {
            // Capturamos el mensaje de error ("El alumno con ID ... no existe")
            JOptionPane.showMessageDialog(null, e.getMessage(), "Error de Eliminación", JOptionPane.ERROR_MESSAGE);
        }
    }

    private void buscarAlumnoPorId(RegistroAlumnos registroAlumnos) {
        String id = JOptionPane.showInputDialog("Ingrese el ID del alumno a buscar:");
        // Validación de cancelación
        if (id == null || id.trim().isEmpty()) {
            return;
        }
        try {
            // La lógica lanza EntidadNoEncontradaException si el ID no existe
            Alumno a = registroAlumnos.buscarAlumno(id);
            // Si lo encuentra, lo muestra usando tu método formatearAlumno
            JOptionPane.showMessageDialog(null, formatearAlumno(a), "Detalles del Alumno", JOptionPane.INFORMATION_MESSAGE);
        } catch (EntidadNoEncontradaException e) {
            // Si no existe, mostramos el mensaje que viene desde la lógica
            JOptionPane.showMessageDialog(null, e.getMessage(), "Resultado de búsqueda", JOptionPane.WARNING_MESSAGE);
        }
    }

    private void buscarAlumnoPorNombreYCarrera(RegistroAlumnos registroAlumnos) {
        String n = JOptionPane.showInputDialog("Nombre:");
        String c = JOptionPane.showInputDialog("Carrera:");
        Alumno a = registroAlumnos.buscarAlumno(n, c);
        if (a != null) {
            JOptionPane.showMessageDialog(null, formatearAlumno(a));
        } else {
            JOptionPane.showMessageDialog(null, "No encontrado.");
        }
    }

    private void mostrarAlumnosEnRiesgo(RegistroAlumnos registroAlumnos) {
        String v = JOptionPane.showInputDialog("Porcentaje minimo (ej: 50):");
        if (v == null) {
            return;
        }
        double p = Double.parseDouble(v);
        List<Alumno> lista = registroAlumnos.obtenerAlumnosEnRiesgo(p);
        String texto = "ALUMNOS CON PROGRESO MENOR A " + p + "%\n";
        for (Alumno a : lista) {
            texto += "- " + a.getNombre() + " (" + a.calcularProgreso() + "%)\n";
        }
        mostrarMensaje("RIESGO ACADEMICO", texto);
    }

