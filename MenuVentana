    /**
     * Inicia el flujo de gestión de la malla curricular para un alumno específico.
     * Captura excepciones si el alumno no existe y muestra un cuadro de error.
     * 
     * @param registroAlumnos Gestor necesario para validar la existencia del alumno.
     */
    private void gestionarAsignaturasAlumno(RegistroAlumnos registroAlumnos) {
        String id = JOptionPane.showInputDialog("Ingrese ID del alumno para gestionar su malla:");

        if (id == null) {
            return;
        }

        try {
            Alumno alumno = registroAlumnos.buscarAlumno(id);
            int opcion;

            do {
                String menu = "Gestion de Asignaturas - Alumno: " + alumno.getNombre().toUpperCase() + "\n"
                        + "1. Agregar Asignatura\n"
                        + "2. Mostrar Malla Curricular\n"
                        + "3. Modificar Estado (Aprobada/Pendiente)\n"
                        + "4. Eliminar Asignatura\n"
                        + "5. Buscar Asignatura por Codigo\n"
                        + "6. Volver";

                String entrada = JOptionPane.showInputDialog(null, menu);

                if (entrada == null) {
                    break;
                }

                opcion = leerEntero(entrada);

                switch (opcion) {
                    case 1:
                        agregarAsignaturaMalla(alumno);
                        break;
                    case 2:
                        mostrarMalla(alumno);
                        break;
                    case 3:
                        modificarEstadoAsignatura(alumno);
                        break;
                    case 4:
                        eliminarAsignaturaMalla(alumno);
                        break;
                    case 5:
                        buscarAsignaturaMalla(alumno);
                        break;
                }
            } while (opcion != 6);

        } catch (EntidadNoEncontradaException e) {
            JOptionPane.showMessageDialog(null, e.getMessage(), "Error", JOptionPane.ERROR_MESSAGE);
        }
    }

    /**
     * Solicita datos mediante ventanas emergentes para agregar una nueva asignatura a un alumno.
     * 
     * @param alumno El objeto Alumno al cual se le añadirá la asignatura.
     */
    private void agregarAsignaturaMalla(Alumno alumno) {
        String tipo = JOptionPane.showInputDialog("Tipo de asignatura:\n1. Obligatoria\n2. Electiva\n3. Rapida (Obligatoria Semestre 1)");
        if (tipo == null) return;

        String nom = JOptionPane.showInputDialog("Nombre de la asignatura:");
        if (nom == null) return;

        String cod = JOptionPane.showInputDialog("Codigo:");
        if (cod == null) return;

        int cre = leerEntero(JOptionPane.showInputDialog("Creditos:"));

        try {
            switch (tipo) {
                case "1":
                    int sem = leerEntero(JOptionPane.showInputDialog("Semestre (1-10):"));
                    alumno.agregarAsignatura(new AsignaturaObligatoria(nom, cod, cre, sem));
                    break;
                case "2":
                    String area = JOptionPane.showInputDialog("Area de interes:");
                    if (area == null) return;
                    alumno.agregarAsignatura(new AsignaturaElectiva(nom, cod, cre, area));
                    break;
                case "3":
                    alumno.agregarAsignatura(nom, cod, cre);
                    break;
                default:
                    JOptionPane.showMessageDialog(null, "Opción inválida.");
                    return;
            }
            JOptionPane.showMessageDialog(null, "Asignatura agregada con exito a la malla de " + alumno.getNombre());

        } catch (AtributoInvalidoException e) {
            JOptionPane.showMessageDialog(null, e.getMessage(), "Error al agregar", JOptionPane.WARNING_MESSAGE);
        }
    }

    /**
     * Busca y muestra los detalles de una asignatura específica en la malla de un alumno.
     * 
     * @param alumno El objeto Alumno en el que se realizará la búsqueda.
     */
    private void buscarAsignaturaMalla(Alumno alumno) {
        String cod = JOptionPane.showInputDialog("Ingrese código a buscar:");
        if (cod == null || cod.isEmpty()) return;

        try {
            Asignatura b = alumno.buscarAsignatura(cod);
            String info = "Detalles de Asignatura:\n"
                    + "• Nombre: " + b.getNombre() + "\n"
                    + "• Créditos: " + b.getCreditos() + "\n"
                    + "• Estado: " + (b.isAprobada() ? "Aprobada" : "Pendiente");

            JOptionPane.showMessageDialog(null, info, "Resultado de Búsqueda", JOptionPane.INFORMATION_MESSAGE);

        } catch (EntidadNoEncontradaException e) {
            JOptionPane.showMessageDialog(null, e.getMessage(), "Búsqueda", JOptionPane.WARNING_MESSAGE);
        }
    }

    /**
     * Elimina una asignatura de la malla de un alumno con confirmación previa del usuario.
     * 
     * @param alumno El objeto Alumno del cual se eliminará la asignatura.
     */
    private void eliminarAsignaturaMalla(Alumno alumno) {
        String cod = JOptionPane.showInputDialog("Código de la asignatura a eliminar:");
        if (cod == null || cod.isEmpty()) return;

        try {
            Asignatura asig = alumno.buscarAsignatura(cod);
            int confirm = JOptionPane.showConfirmDialog(null,
                    "¿Seguro que desea eliminar '" + asig.getNombre() + "' de la malla?",
                    "Confirmar Eliminación", JOptionPane.YES_NO_OPTION);

            if (confirm == JOptionPane.YES_OPTION) {
                alumno.eliminarAsignatura(cod);
                JOptionPane.showMessageDialog(null, "Asignatura eliminada correctamente.");
            }
        } catch (EntidadNoEncontradaException e) {
            JOptionPane.showMessageDialog(null, e.getMessage(), "Error", JOptionPane.ERROR_MESSAGE);
        }
    }

    /**
     * Modifica el estado de aprobación de una materia inscrita por un alumno.
     * 
     * @param alumno El objeto Alumno propietario de la asignatura.
     */
    private void modificarEstadoAsignatura(Alumno alumno) {
        String cod = JOptionPane.showInputDialog("Ingrese código de la asignatura:");
        if (cod == null || cod.isEmpty()) return;

        try {
            Asignatura asig = alumno.buscarAsignatura(cod);
            int r = JOptionPane.showConfirmDialog(null,
                    "¿Está aprobada la asignatura '" + asig.getNombre() + "'?",
                    "Actualizar Estado", JOptionPane.YES_NO_OPTION);

            asig.setAprobada(r == JOptionPane.YES_OPTION);
            JOptionPane.showMessageDialog(null, "Estado actualizado correctamente.");

        } catch (EntidadNoEncontradaException e) {
            JOptionPane.showMessageDialog(null, e.getMessage(), "Aviso", JOptionPane.WARNING_MESSAGE);
        }
    }

    /**
     * Genera un reporte formateado con toda la malla curricular del alumno y lo muestra
     * utilizando un componente de texto con barra de desplazamiento (JScrollPane).
     * 
     * @param alumno El objeto Alumno cuya malla se desea visualizar.
     */
    private void mostrarMalla(Alumno alumno) {
        if (alumno.getMalla().isEmpty()) {
            JOptionPane.showMessageDialog(null, "La malla se encuentra vacía.", "Malla Curricular", JOptionPane.INFORMATION_MESSAGE);
            return;
        }
        StringBuilder reporte = new StringBuilder();
        reporte.append("--- LISTADO DE ASIGNATURAS ---\n");
        reporte.append("Alumno: ").append(alumno.getNombre()).append("\n\n");
        for (Asignatura a : alumno.getMalla()) {
            reporte.append("Código: ").append(a.getCodigo()).append("\n")
                    .append("Nombre: ").append(a.getNombre()).append("\n")
                    .append("Créditos: ").append(a.getCreditos()).append("\n")
                    .append("Estado: ").append(a.isAprobada() ? "Aprobada" : "Pendiente").append("\n");
            if (a instanceof AsignaturaObligatoria) {
                AsignaturaObligatoria ob = (AsignaturaObligatoria) a;
                reporte.append("Tipo: Obligatoria\n")
                        .append("Semestre: ").append(ob.getSemestre()).append("\n");
            } else if (a instanceof AsignaturaElectiva) {
                AsignaturaElectiva el = (AsignaturaElectiva) a;
                reporte.append("Tipo: Electiva\n")
                        .append("Área: ").append(el.getArea()).append("\n");
            }
            reporte.append("----------------------------------\n");
        }
        
        JTextArea textArea = new JTextArea(reporte.toString());
        textArea.setEditable(false);
        JScrollPane scrollPane = new JScrollPane(textArea);
        scrollPane.setPreferredSize(new java.awt.Dimension(400, 300));
        JOptionPane.showMessageDialog(null, scrollPane, "Malla Curricular", JOptionPane.PLAIN_MESSAGE);
    }

    /**
     * Inicia el flujo de gestión de las asignaturas dictadas por un profesor.
     * 
     * @param registroProfesores Gestor necesario para validar la existencia del profesor.
     */
    private void gestionarAsignaturasProfesor(RegistroProfesores registroProfesores) {
        String id = JOptionPane.showInputDialog("Ingrese ID del profesor:");
        if (id == null || id.isEmpty()) return;

        try {
            Profesor prof = registroProfesores.buscarProfesor(id);
            ejecutarMenuInternoAsignaturas(prof);
        } catch (EntidadNoEncontradaException e) {
            JOptionPane.showMessageDialog(null, e.getMessage(), "Error", JOptionPane.ERROR_MESSAGE);
        }
    }

    /**
     * Submenú interno de gestión de carga académica para un profesor específico.
     * 
     * @param prof Instancia del profesor seleccionado.
     */
    private void ejecutarMenuInternoAsignaturas(Profesor prof) {
        int opcion;
        do {
            String menu = "Gestión de Asignaturas - Prof: " + prof.getNombre().toUpperCase() + "\n"
                    + "1. Vincular nueva Asignatura\n"
                    + "2. Ver listado dictado\n"
                    + "3. Editar nombre de asignatura\n"
                    + "4. Eliminar asignatura\n"
                    + "5. Volver";

            String entrada = JOptionPane.showInputDialog(null, menu);
            if (entrada == null) break;
            opcion = leerEntero(entrada);

            switch (opcion) {
                case 1: uiAgregarAsignatura(prof); break;
                case 2: uiMostrarAsignaturas(prof); break;
                case 3: uiEditarAsignatura(prof); break;
                case 4: uiEliminarAsignatura(prof); break;
            }
        } while (opcion != 5);
    }

    /**
     * Muestra la lista de materias que dicta un profesor utilizando un panel con scroll.
     * 
     * @param prof El objeto Profesor cuya carga académica se visualizará.
     */
    private void uiMostrarAsignaturas(Profesor prof) {
        List<Asignatura> asignaturas = prof.getAsignaturas();

        if (asignaturas.isEmpty()) {
            JOptionPane.showMessageDialog(null,
                    "El profesor " + prof.getNombre() + " no tiene asignaturas a cargo.",
                    "Información", JOptionPane.INFORMATION_MESSAGE);
            return;
        }

        StringBuilder sb = new StringBuilder("Asignaturas dictadas por: " + prof.getNombre() + "\n\n");
        for (Asignatura asig : asignaturas) {
            sb.append("• [").append(asig.getCodigo()).append("] ")
                    .append(asig.getNombre())
                    .append(" (").append(asig.getCreditos()).append(" créditos)\n");
        }

        JTextArea textArea = new JTextArea(sb.toString());
        textArea.setEditable(false);
        JScrollPane scrollPane = new JScrollPane(textArea);
        scrollPane.setPreferredSize(new java.awt.Dimension(400, 300));

        JOptionPane.showMessageDialog(null, scrollPane, "Listado de Asignaturas", JOptionPane.PLAIN_MESSAGE);
    }

    /**
     * Elimina una asignatura de la carga académica de un profesor con confirmación visual.
     * 
     * @param prof El objeto Profesor afectado.
     */
    private void uiEliminarAsignatura(Profesor prof) {
        String codigo = JOptionPane.showInputDialog("Ingrese el código de la asignatura que desea eliminar:");
        if (codigo == null || codigo.trim().isEmpty()) return;

        try {
            Asignatura asig = prof.buscarAsignatura(codigo);
            int confirmar = JOptionPane.showConfirmDialog(null,
                    "¿Está seguro de que desea desvincular la asignatura '" + asig.getNombre() + "'?",
                    "Confirmar eliminación", JOptionPane.YES_NO_OPTION);

            if (confirmar == JOptionPane.YES_OPTION) {
                prof.eliminarAsignatura(codigo);
                JOptionPane.showMessageDialog(null, "Asignatura eliminada con éxito.");
            }

        } catch (EntidadNoEncontradaException e) {
            JOptionPane.showMessageDialog(null, e.getMessage(), "Error al eliminar", JOptionPane.ERROR_MESSAGE);
        }
    }

    /**
     * Permite modificar el nombre de una materia dictada por el profesor.
     * 
     * @param prof El objeto Profesor afectado.
     */
    private void uiEditarAsignatura(Profesor prof) {
        String cod = JOptionPane.showInputDialog("Código de la asignatura a editar:");
        if (cod == null) return;

        try {
            Asignatura asig = prof.buscarAsignatura(cod);
            String nuevoNombre = JOptionPane.showInputDialog("Nuevo nombre para " + asig.getNombre() + ":");
            if (nuevoNombre != null && !nuevoNombre.isEmpty()) {
                asig.setNombre(nuevoNombre);
                JOptionPane.showMessageDialog(null, "Actualización exitosa.");
            }
        } catch (EntidadNoEncontradaException e) {
            JOptionPane.showMessageDialog(null, e.getMessage(), "Aviso", JOptionPane.WARNING_MESSAGE);
        }
    }

    /**
     * Vincula una nueva materia al profesor capturando la información mediante cuadros de texto.
     * 
     * @param prof El objeto Profesor al que se le añadirá la carga.
     */
    private void uiAgregarAsignatura(Profesor prof) {
        try {
            String nom = JOptionPane.showInputDialog("Nombre:");
            String cod = JOptionPane.showInputDialog("Código:");
            String creStr = JOptionPane.showInputDialog("Créditos:");

            if (nom == null || cod == null || creStr == null) return;

            int cre = leerEntero(creStr);
            if (cre <= 0) {
                throw new AtributoInvalidoException("Los créditos deben ser un número positivo.");
            }

            prof.asignarAsignatura(new AsignaturaObligatoria(nom, cod, cre, 1));
            JOptionPane.showMessageDialog(null, "Asignatura vinculada correctamente.");

        } catch (AtributoInvalidoException e) {
            JOptionPane.showMessageDialog(null, e.getMessage(), "Error de validación", JOptionPane.ERROR_MESSAGE);
        }
    }

