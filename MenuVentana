    /**
     * Convierte una cadena de texto (String) a un número entero de manera segura.
     * Evita caídas de la aplicación si el usuario ingresa letras en vez de números.
     * 
     * @param entrada Texto ingresado por el usuario en el JOptionPane.
     * @return El número entero, o -1 si ocurrió un error de formato.
     */
    private int leerEntero(String entrada) {
        try {
            return Integer.parseInt(entrada);
        } catch (Exception e) {
            return -1;
        }
    }

    /**
     * Muestra bloques de texto largos dentro de un área de texto desplazable (JScrollPane).
     * Ideal para mostrar reportes o listas extensas en la interfaz gráfica.
     * 
     * @param titulo El título de la ventana.
     * @param contenido El texto extenso a mostrar en el panel.
     */
    private void mostrarMensaje(String titulo, String contenido) {
        JTextArea textArea = new JTextArea(20, 50); 
        textArea.setText(contenido);
        textArea.setEditable(false); 
        textArea.setLineWrap(true);  
        textArea.setWrapStyleWord(true);
        textArea.setCaretPosition(0); 
        
        JScrollPane scrollPane = new JScrollPane(textArea);
        JOptionPane.showMessageDialog(null, scrollPane, titulo, JOptionPane.INFORMATION_MESSAGE);
    }

    /**
     * Genera un String concatenado con la información de todos los alumnos registrados.
     * 
     * @param registroAlumnos Gestor de alumnos.
     * @return Una cadena de texto lista para ser mostrada en pantalla.
     */
    private String obtenerListadoAlumnos(RegistroAlumnos registroAlumnos) {
        if (registroAlumnos.getAlumnos().isEmpty()) {
            return "No hay alumnos.";
        }
        String t = "";
        for (Alumno a : registroAlumnos.getAlumnos().values()) {
            t += formatearAlumno(a) + "\n";
        }
        return t;
    }

    /**
     * Genera un String concatenado con la información de todos los profesores registrados.
     * 
     * @param registroProfesores Gestor de profesores.
     * @return Una cadena de texto lista para ser mostrada en pantalla.
     */
    private String obtenerListadoProfesores(RegistroProfesores registroProfesores) {
        if (registroProfesores.getProfesores().isEmpty()) {
            return "No hay profesores.";
        }
        String t = "";
        for (Profesor p : registroProfesores.getProfesores().values()) {
            t += formatearProfesor(p) + "\n";
        }
        return t;
    }

    /**
     * Aplica formato visual a los datos individuales de un Alumno para la GUI.
     * 
     * @param alumno El objeto alumno a formatear.
     * @return Cadena de texto estructurada.
     */
    private String formatearAlumno(Alumno alumno) {
        return "ID: " + alumno.getId() + " | Nombre: " + alumno.getNombre()
                + "\nCarrera: " + alumno.getCarrera() + " | Progreso: " + String.format("%.2f", alumno.calcularProgreso()) + "%"
                + "\n-----------------------------";
    }

    /**
     * Aplica formato visual a los datos individuales de un Profesor para la GUI.
     * 
     * @param profesor El objeto profesor a formatear.
     * @return Cadena de texto estructurada.
     */
    private String formatearProfesor(Profesor profesor) {
        return "ID: " + profesor.getId() + " | Nombre: " + profesor.getNombre()
                + "\nEspecialidad: " + profesor.getEspecialidad() + " | Asignaturas: " + profesor.getAsignaturas().size()
                + "\n-----------------------------";
    }
