package avanceCurricular;

import java.io.*;
import java.util.*;

public class PersistenciaData {

    private static final String ARCHIVO_ALUMNOS = "alumnos.txt";
    private static final String ARCHIVO_PROFESORES = "profesores.txt";
    private static final String ASIG_ALUMNOS = "asignaturas_alumnos.txt";
    private static final String ASIG_PROFESORES = "asignaturas_profesores.txt";

    public static void cargarTodo(RegistroAlumnos ra, RegistroProfesores rp) {
        cargarAlumnos(ra);
        cargarProfesores(rp);
        cargarAsignaturasAlumnos(ra);
        cargarAsignaturasProfesores(rp);
        System.out.println("Datos y asignaturas cargados correctamente.");
    }

    private static void cargarAlumnos(RegistroAlumnos ra) {
        File file = new File(ARCHIVO_ALUMNOS);
        
        if (!file.exists()) {
            try {
                // SIA-3: Datos semilla manejados con try-catch (SIA-12)
                ra.agregarAlumno("A001", "Juan Perez", "Ingenieria Informatica");
                ra.agregarAlumno("A002", "Maria Lopez", "Ingenieria Civil");
                ra.agregarAlumno("A003", "Carlos Santana", "Ingenieria Informatica");
            } catch (AtributoInvalidoException e) {
                System.err.println("Error en datos semilla de alumnos: " + e.getMessage());
            }
            return; 
        }
        
        try (Scanner sc = new Scanner(file)) {
            while (sc.hasNextLine()) {
                String[] partes = sc.nextLine().split(";");
                // Capturamos la excepción específica que lanza agregarAlumno
                if (partes.length == 3) ra.agregarAlumno(partes[0], partes[1], partes[2]);
            }
        } catch (IOException | AtributoInvalidoException e) { 
            System.err.println("Error procesando alumnos: " + e.getMessage());
        }
    }

    private static void cargarProfesores(RegistroProfesores rp) {
        File file = new File(ARCHIVO_PROFESORES);
        if (!file.exists()) {
            try {
                rp.agregarProfesor("P001", "Alan Turing", "Matematicas Computacionales");
                rp.agregarProfesor("P002", "Ada Lovelace", "Algoritmos");
            } catch (AtributoInvalidoException e) {
                System.err.println("Error en datos semilla de profesores: " + e.getMessage());
            }
            return;
        }
        try (Scanner sc = new Scanner(file)) {
            while (sc.hasNextLine()) {
                String[] partes = sc.nextLine().split(";");
                if (partes.length == 3) rp.agregarProfesor(partes[0], partes[1], partes[2]);
            }
        } catch (IOException | AtributoInvalidoException e) {
            System.err.println("Error procesando profesores: " + e.getMessage());
        }
    }

    public static void cargarAsignaturasAlumnos(RegistroAlumnos ra) {
        File file = new File(ASIG_ALUMNOS);
        if (!file.exists()) {
            try {
                Alumno a1 = ra.getAlumnos().get("A001");
                if (a1 != null) {
                    Asignatura asig1 = new AsignaturaObligatoria("Programacion Avanzada", "INF2241", 6, 3);
                    asig1.setAprobada(true);
                    a1.agregarAsignatura(asig1);
                    a1.agregarAsignatura(new AsignaturaElectiva("Inteligencia Artificial", "INF300", 4, "Tecnologia"));
                }
            } catch (AtributoInvalidoException e) {
                System.err.println("Error en mallas semilla: " + e.getMessage());
            }
            return;
        }
        
        try (Scanner sc = new Scanner(file)) {
            while (sc.hasNextLine()) {
                String[] p = sc.nextLine().split(";");
                if (p.length < 7) continue;

                int creditos = Integer.parseInt(p[4]);
                Asignatura asig = p[1].equals("OBL") 
                    ? new AsignaturaObligatoria(p[2], p[3], creditos, Integer.parseInt(p[6]))
                    : new AsignaturaElectiva(p[2], p[3], creditos, p[6]);
                
                asig.setAprobada(Boolean.parseBoolean(p[5]));
                Alumno alumno = ra.getAlumnos().get(p[0]);
                if (alumno != null) alumno.agregarAsignatura(asig);
            }
        } catch (IOException | AtributoInvalidoException | NumberFormatException e) {
            System.err.println("Error en asignaturas de alumnos: " + e.getMessage());
        }
    }

    public static void cargarAsignaturasProfesores(RegistroProfesores rp) {
        File file = new File(ASIG_PROFESORES);
        if (!file.exists()) {
            try {
                Profesor p1 = rp.getProfesores().get("P001");
                if (p1 != null) p1.asignarAsignatura(new AsignaturaObligatoria("Calculo I", "MAT101", 6, 1));
            } catch (AtributoInvalidoException e) {
                System.err.println("Error en carga académica semilla: " + e.getMessage());
            }
            return;
        }
        
        try (Scanner sc = new Scanner(file)) {
            while (sc.hasNextLine()) {
                String[] p = sc.nextLine().split(";");
                if (p.length < 7) continue;

                int creditos = Integer.parseInt(p[4]);
                Asignatura asig = p[1].equals("OBL")
                    ? new AsignaturaObligatoria(p[2], p[3], creditos, Integer.parseInt(p[6]))
                    : new AsignaturaElectiva(p[2], p[3], creditos, p[6]);

                Profesor prof = rp.getProfesores().get(p[0]);
                if (prof != null) prof.asignarAsignatura(asig);
            }
        } catch (IOException | AtributoInvalidoException | NumberFormatException e) {
            System.err.println("Error en asignaturas de profesores: " + e.getMessage());
        }
    }

    // Los métodos de guardado se mantienen igual ya que solo lanzan IOException (ya manejada)
    public static void guardarTodo(RegistroAlumnos ra, RegistroProfesores rp) {
        guardarAlumnos(ra);
        guardarProfesores(rp);
        guardarAsignaturasAlumnos(ra);
        guardarAsignaturasProfesores(rp);
        System.out.println(" Todos los cambios han sido guardados.");
    }

    private static void guardarAlumnos(RegistroAlumnos ra) {
        try (PrintWriter pw = new PrintWriter(new FileWriter(ARCHIVO_ALUMNOS))) {
            for (Alumno a : ra.getAlumnos().values()) {
                pw.println(a.getId() + ";" + a.getNombre() + ";" + a.getCarrera());
            }
        } catch (IOException e) {
            System.err.println("Error al guardar alumnos: " + e.getMessage());
        }
    }

    private static void guardarProfesores(RegistroProfesores rp) {
        try (PrintWriter pw = new PrintWriter(new FileWriter(ARCHIVO_PROFESORES))) {
            for (Profesor p : rp.getProfesores().values()) {
                pw.println(p.getId() + ";" + p.getNombre() + ";" + p.getEspecialidad());
            }
        } catch (IOException e) {
            System.err.println("Error al guardar profesores: " + e.getMessage());
        }
    }

    private static void guardarAsignaturasAlumnos(RegistroAlumnos ra) {
        try (PrintWriter pw = new PrintWriter(new FileWriter(ASIG_ALUMNOS))) {
            for (Alumno a : ra.getAlumnos().values()) {
                for (Asignatura asig : a.getMalla()) {
                    String tipo = (asig instanceof AsignaturaObligatoria) ? "OBL" : "ELE";
                    String extra = (asig instanceof AsignaturaObligatoria) 
                        ? String.valueOf(((AsignaturaObligatoria)asig).getSemestre()) 
                        : ((AsignaturaElectiva)asig).getArea();
                    
                    pw.println(a.getId() + ";" + tipo + ";" + asig.getNombre() + ";" + 
                               asig.getCodigo() + ";" + asig.getCreditos() + ";" + 
                               asig.isAprobada() + ";" + extra);
                }
            }
        } catch (IOException e) {
            System.err.println("Error al guardar asignaturas alumnos: " + e.getMessage());
        }
    }

    private static void guardarAsignaturasProfesores(RegistroProfesores rp) {
        try (PrintWriter pw = new PrintWriter(new FileWriter(ASIG_PROFESORES))) {
            for (Profesor p : rp.getProfesores().values()) {
                for (Asignatura asig : p.getAsignaturas()) {
                    String tipo = (asig instanceof AsignaturaObligatoria) ? "OBL" : "ELE";
                    String extra = (asig instanceof AsignaturaObligatoria) 
                        ? String.valueOf(((AsignaturaObligatoria)asig).getSemestre()) 
                        : ((AsignaturaElectiva)asig).getArea();
                    
                    pw.println(p.getId() + ";" + tipo + ";" + asig.getNombre() + ";" + 
                               asig.getCodigo() + ";" + asig.getCreditos() + ";true;" + extra);
                }
            }
        } catch (IOException e) {
            System.err.println("Error al guardar asignaturas profesores: " + e.getMessage());
        }
    }
}
