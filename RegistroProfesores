package avanceCurricular;

import java.util.*;

/**
 * Clase gestora encargada de administrar la colección de profesores del sistema.
 * Utiliza un {@link Map} para el almacenamiento, permitiendo el acceso rápido a los 
 * datos de los docentes a través de su identificador único[: 7].
 */
public class RegistroProfesores {

    // ATRIBUTO
    /**
     * Mapa interno que almacena los profesores, utilizando el ID como clave 
     * y el objeto {@link Profesor} como valor[: 7].
     */
    private final Map<String, Profesor> profesores;

    // CONSTRUCTOR
    /**
     * Inicializa un nuevo registro de profesores configurando el mapa interno 
     * como un {@link HashMap} vacío[: 7].
     */
    public RegistroProfesores() {
        this.profesores = new HashMap<>();
    }

    // GETTER Y SETTER
    /**
     * Retorna una copia defensiva del mapa de profesores.
     * Se crea una nueva instancia del mapa para evitar la manipulación directa 
     * de la colección interna desde el exterior[: 7].
     * 
     * @return Un nuevo {@link HashMap} con los registros actuales de profesores[: 7].
     */
    public Map<String, Profesor> getProfesores() {
        return new HashMap<>(this.profesores);
    }

    /**
     * Reemplaza la colección completa de profesores por una nueva.
     * 
     * @param profesores El nuevo mapa de profesores a establecer. Si es nulo, no realiza cambios[: 7].
     */
    public void setProfesores(Map<String, Profesor> profesores) {
        if (profesores != null) {
            this.profesores.clear();
            this.profesores.putAll(profesores);
        }
    }

    // INSERCIÓN
    /**
     * Registra un objeto Profesor previamente instanciado en el sistema.
     * Realiza validaciones de nulidad y verifica que el ID no esté duplicado en el mapa[: 7].
     * 
     * @param profesor El objeto {@link Profesor} que se desea agregar[: 7].
     * @throws AtributoInvalidoException Si el profesor es nulo, el ID es inválido o ya se encuentra registrado[: 7].
     */
    public void agregarProfesor(Profesor profesor) throws AtributoInvalidoException {
        try {
            if (profesor == null) {
                throw new AtributoInvalidoException("Error: No se puede agregar un profesor nulo.");
            }

            if (profesor.getId() == null || profesor.getId().trim().isEmpty()) {
                throw new AtributoInvalidoException("Error: El ID del profesor no puede estar vacío.");
            }

            if (profesores.containsKey(profesor.getId())) {
                throw new AtributoInvalidoException("Error: Ya existe un profesor con el ID " + profesor.getId() + ".");
            }

            profesores.put(profesor.getId(), profesor);

        } catch (AtributoInvalidoException e) {
            throw e;
        }
    }

    /**
     * Sobrecarga del método de inserción que crea y registra un profesor a partir de sus atributos básicos (SIA-5).
     * 
     * @param id Identificador único para el nuevo profesor.
     * @param nombre Nombre completo del docente.
     * @param especialidad Área de especialización académica.
     * @throws AtributoInvalidoException Si los datos proporcionados no cumplen con las reglas de validación[: 7].
     */
    public void agregarProfesor(String id, String nombre, String especialidad) throws AtributoInvalidoException {
        try {
            if (id == null || id.trim().isEmpty()) {
                throw new AtributoInvalidoException("Error: El ID del profesor no puede estar vacío.");
            }

            if (profesores.containsKey(id)) {
                throw new AtributoInvalidoException("Error: Ya existe un profesor con el ID " + id + ".");
            }

            profesores.put(id, new Profesor(id, nombre, especialidad));
            
        } catch (AtributoInvalidoException e) {
            throw e;
        }
    }

    // BÚSQUEDA
    /**
     * Localiza a un profesor en el registro utilizando su ID.
     * 
     * @param id Identificador del profesor a buscar.
     * @return El objeto {@link Profesor} encontrado[: 7].
     * @throws EntidadNoEncontradaException Si no existe ningún profesor asociado a ese ID[: 7].
     */
    public Profesor buscarProfesor(String id) throws EntidadNoEncontradaException {
        try {
            Profesor p = profesores.get(id);
            if (p == null) {
                throw new EntidadNoEncontradaException("El profesor con ID " + id + " no existe.");
            }
            return p;
        } catch (EntidadNoEncontradaException e) {
            throw e;
        }
    }

    /**
     * Sobrecarga del método de búsqueda que localiza a un profesor por su nombre (SIA-5).
     * Realiza una iteración sobre la colección para encontrar la primera coincidencia exacta[: 7].
     * 
     * @param nombre Nombre completo del profesor a buscar (no sensible a mayúsculas/minúsculas).
     * @return La instancia del profesor encontrado[: 7].
     * @throws EntidadNoEncontradaException Si no se encuentra ningún docente con ese nombre[: 7].
     */
    public Profesor buscarProfesorPorNombre(String nombre) throws EntidadNoEncontradaException {
        try {
            Collection<Profesor> lista = profesores.values();
            for (Profesor profesor : lista) {
                if (profesor.getNombre().equalsIgnoreCase(nombre)) {
                    return profesor;
                }
            }
            throw new EntidadNoEncontradaException("Error: No se encontro un profesor con el nombre: " + nombre);
            
        } catch (EntidadNoEncontradaException e) {
            throw e;
        }
    }

    // EDICIÓN    
    /**
     * Actualiza la información personal de un docente tras validar que los nuevos datos sean correctos.
     * 
     * @param id ID del profesor que se desea editar.
     * @param nuevoNombre Nuevo nombre para el docente.
     * @param nuevaEspecialidad Nueva especialidad académica.
     * @throws EntidadNoEncontradaException Si el profesor no existe en el registro.
     * @throws AtributoInvalidoException Si los campos de actualización están vacíos o son nulos[: 7].
     */
    public void editarProfesor(String id, String nuevoNombre, String nuevaEspecialidad) throws EntidadNoEncontradaException, AtributoInvalidoException {
        try {
            if (nuevoNombre == null || nuevoNombre.trim().isEmpty()) {
                throw new AtributoInvalidoException("Error: El nombre del profesor no puede estar vacío.");
            }
            if (nuevaEspecialidad == null || nuevaEspecialidad.trim().isEmpty()) {
                throw new AtributoInvalidoException("Error: La especialidad no puede estar vacía.");
            }

            Profesor profesor = buscarProfesor(id);
            profesor.setNombre(nuevoNombre);
            profesor.setEspecialidad(nuevaEspecialidad);
            
        } catch (EntidadNoEncontradaException | AtributoInvalidoException e) {
            throw e;
        }
    }

    // ELIMINACIÓN
    /**
     * Remueve a un profesor del registro basándose en su identificador único.
     * 
     * @param id ID del profesor a eliminar.
     * @throws EntidadNoEncontradaException Si el identificador no existe en la colección[: 7].
     */
    public void eliminarProfesor(String id) throws EntidadNoEncontradaException {
        try {
            if (!profesores.containsKey(id)) {
                throw new EntidadNoEncontradaException("Error: No se puede eliminar. Profesor no encontrado.");
            }
            profesores.remove(id);
            
        } catch (EntidadNoEncontradaException e) {
            throw e;
        }
    }

    // LISTADO
    /**
     * Imprime por consola la información básica de todos los profesores registrados actualmente[: 7].
     */
    public void mostrarProfesores() {
        if (profesores.isEmpty()) {
            System.out.println("No hay profesores registrados.");
            return;
        }

        for (Profesor profesor : profesores.values()) {
            profesor.mostrarInfo();
        }
    }

    // FUNCIONALIDAD DE NEGOCIO 
    /**
     * Filtra la colección de profesores para obtener un subconjunto basado en una especialidad (SIA-9).
     * 
     * @param especialidad El área académica por la cual filtrar.
     * @return Una {@link List} con los profesores que pertenecen a dicha especialidad[: 7].
     */
    public List<Profesor> obtenerProfesoresPorEspecialidad(String especialidad) {
        List<Profesor> filtrados = new ArrayList<>();
        
        for (Profesor profesor : profesores.values()) {
            if (profesor.getEspecialidad().equalsIgnoreCase(especialidad)) {
                filtrados.add(profesor);
            }
        }
        
        return filtrados;
    }

    // UTILIDADES
    /**
     * Obtiene la cantidad total de profesores inscritos en el sistema[: 7].
     * @return El número de registros en el mapa.
     */
    public int getCantidadProfesores() {
        return profesores.size();
    }

    /**
     * Comprueba si un profesor existe en el registro mediante su identificador.
     * 
     * @param id El ID a verificar.
     * @return true si el profesor está registrado, false en caso contrario o si el ID es nulo[: 7].
     */
    public boolean existeProfesor(String id) {
        if (id == null) {
            return false;
        }

        return profesores.containsKey(id);
    }
}
