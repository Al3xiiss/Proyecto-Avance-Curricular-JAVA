package avanceCurricular;

import java.util.*;

public class RegistroProfesores {

    // ATRIBUTO
    private final Map<String, Profesor> profesores;

    // CONSTRUCTOR
    public RegistroProfesores() {
        this.profesores = new HashMap<>();
    }

    // GETTER Y SETTER
    public Map<String, Profesor> getProfesores() {
        return new HashMap<>(this.profesores);
    }

    public void setProfesores(Map<String, Profesor> profesores) {
        if (profesores != null) {
            this.profesores.clear();
            this.profesores.putAll(profesores);
        }
    }

    // INSERCIÓN
    public void agregarProfesor(Profesor profesor) throws AtributoInvalidoException {
        try {
            if (profesor == null) {
                throw new AtributoInvalidoException("Error: No se puede agregar un profesor nulo.");
            }

            if (profesor.getId() == null || profesor.getId().trim().isEmpty()) {
                throw new AtributoInvalidoException("Error: El ID del profesor no puede estar vacío.");
            }

            if (profesores.containsKey(profesor.getId())) {
                throw new AtributoInvalidoException("Error: Ya existe un profesor con el ID " + profesor.getId() + ".");
            }

            // Si las validaciones pasan, se añade al HashMap
            profesores.put(profesor.getId(), profesor);

        } catch (AtributoInvalidoException e) {
            // Se atrapa y se relanza para que el Menú  lo maneje finalmente
            throw e;
        }
    }

    // SOBRECARGA (SIA-5)
    public void agregarProfesor(String id, String nombre, String especialidad) throws AtributoInvalidoException {
        try {
            if (id == null || id.trim().isEmpty()) {
                throw new AtributoInvalidoException("Error: El ID del profesor no puede estar vacío.");
            }

            if (profesores.containsKey(id)) {
                throw new AtributoInvalidoException("Error: Ya existe un profesor con el ID " + id + ".");
            }

            profesores.put(id, new Profesor(id, nombre, especialidad));
            
        } catch (AtributoInvalidoException e) {
            throw e;
        }
    }

    // BÚSQUEDA
    public Profesor buscarProfesor(String id) throws EntidadNoEncontradaException {
        try {
            Profesor p = profesores.get(id);
            if (p == null) {
                // Lanzamos la excepción si el objeto es null
                throw new EntidadNoEncontradaException("El profesor con ID " + id + " no existe.");
            }
            return p;
        } catch (EntidadNoEncontradaException e) {
            // Se atrapa y se relanza para cumplir con el uso de try-catch en la lógica
            throw e;
        }
    }

    // SOBRECARGA (SIA-5)
    public Profesor buscarProfesorPorNombre(String nombre) throws EntidadNoEncontradaException {
        try {
            Collection<Profesor> lista = profesores.values();
            for (Profesor profesor : lista) {
                if (profesor.getNombre().equalsIgnoreCase(nombre)) {
                    return profesor;
                }
            }
            // Si termina el ciclo sin encontrar nada, lanzamos la excepción
            throw new EntidadNoEncontradaException("Error: No se encontro un profesor con el nombre: " + nombre);
            
        } catch (EntidadNoEncontradaException e) {
            // Relanzamos la excepción hacia la capa superior
            throw e;
        }
    }

    // EDICIÓN    
    public void editarProfesor(String id, String nuevoNombre, String nuevaEspecialidad) throws EntidadNoEncontradaException, AtributoInvalidoException {
        try {
            if (nuevoNombre == null || nuevoNombre.trim().isEmpty()) {
                throw new AtributoInvalidoException("Error: El nombre del profesor no puede estar vacío.");
            }
            if (nuevaEspecialidad == null || nuevaEspecialidad.trim().isEmpty()) {
                throw new AtributoInvalidoException("Error: La especialidad no puede estar vacía.");
            }

            Profesor profesor = buscarProfesor(id);
            profesor.setNombre(nuevoNombre);
            profesor.setEspecialidad(nuevaEspecialidad);
            
        } catch (EntidadNoEncontradaException | AtributoInvalidoException e) {
            // Relanzamos para que llegue al menú (SIA-12)
            throw e;
        }
    }

    // ELIMINACIÓN
    public void eliminarProfesor(String id) throws EntidadNoEncontradaException {
        try {
            if (!profesores.containsKey(id)) {
                throw new EntidadNoEncontradaException("Error: No se puede eliminar. Profesor no encontrado.");
            }
            profesores.remove(id);
            
        } catch (EntidadNoEncontradaException e) {
            // Atrapamos y relanzamos para que el error viaje hacia el menú
            throw e;
        }
    }

    // LISTADO
    public void mostrarProfesores() {
        if (profesores.isEmpty()) {
            System.out.println("No hay profesores registrados.");
            return;
        }

        for (Profesor profesor : profesores.values()) {
            profesor.mostrarInfo();
        }
    }

    // FUNCIONALIDAD DE NEGOCIO 
    public List<Profesor> obtenerProfesoresPorEspecialidad(String especialidad) {
        List<Profesor> filtrados = new ArrayList<>();
        
        for (Profesor profesor : profesores.values()) {
            if (profesor.getEspecialidad().equalsIgnoreCase(especialidad)) {
                filtrados.add(profesor);
            }
        }
        
        return filtrados;
    }

    // UTILIDADES
    public int getCantidadProfesores() {
        return profesores.size();
    }

    public boolean existeProfesor(String id) {
        if (id == null) {
            return false;
        }

        return profesores.containsKey(id);
    }
}
