package avanceCurricular;
import java.util.*;

public class Alumno {

    // Atributos 
    private String id;
    private String nombre;
    private String carrera;
    private final List<Asignatura> malla;

    // Constructor
    public Alumno(String id, String nombre, String carrera) {
        this.id = id;
        this.nombre = nombre;
        this.carrera = carrera;
        this.malla = new ArrayList<>();
    }


    // GETTERS Y SETTERS (SIA-3 )
    public String getId() {
        return id;
    }

    public void setId(String id) {
        this.id = id;
    }

    public String getNombre() {
        return nombre;
    }

    public void setNombre(String nombre) {
        this.nombre = nombre;
    }

    public String getCarrera() {
        return carrera;
    }

    public void setCarrera(String carrera) {
        this.carrera = carrera;
    }

    public List<Asignatura> getMalla() {
        return new ArrayList<>(this.malla);
    }

    public void setMalla(List<Asignatura> malla) {
        if (malla != null) {
            this.malla.clear();
            this.malla.addAll(malla);
        }
    }

    // MÉTODOS FUNCIONALES

    // Agregar asignatura (Actualizado para SIA-7)
    public void agregarAsignatura(Asignatura asig) throws AtributoInvalidoException {
        try {
            if (asig == null) throw new AtributoInvalidoException("Asignatura nula.");
            if (tieneAsignatura(asig.getCodigo())) {
                throw new AtributoInvalidoException("La asignatura " + asig.getCodigo() + " ya existe.");
            }
            malla.add(asig);
        } catch (AtributoInvalidoException e) { throw e; }
    }

    // Crear y agregar asignatura directamente
    // SOBRECARGA (SIA-5 y SIA-12)
    public void agregarAsignatura(String nombre, String codigo, int creditos) throws AtributoInvalidoException {
        try {
            // Se crea la instancia y se intenta agregar
            Asignatura nueva = new AsignaturaObligatoria(nombre, codigo, creditos, 1);
            
            // Reutiliza la lógica de validación del método agregarAsignatura(Asignatura)
            // que ya tiene implementado su propio manejo de excepciones
            agregarAsignatura(nueva); 
            
        } catch (AtributoInvalidoException e) {
            // Se atrapa y se relanza 
            throw e;
        }
    }

    // Método auxiliar para buscar duplicados
    public boolean tieneAsignatura(String codigo) {
        if (codigo == null) return false;
        for (Asignatura a : malla) {
            if (a.getCodigo().equalsIgnoreCase(codigo)) {
                return true;
            }
        }
        return false;
    } 
    
    // Busca una asignatura por su código en la malla
    public Asignatura buscarAsignatura(String codigo) throws EntidadNoEncontradaException {
        try {
            for (Asignatura a : malla) {
                if (a.getCodigo().equalsIgnoreCase(codigo)) return a;
            }
            throw new EntidadNoEncontradaException("Asignatura no encontrada: " + codigo);
        } catch (EntidadNoEncontradaException e) { throw e; }
    }

    // Elimina una asignatura por su código
    public void eliminarAsignatura(String codigo) throws EntidadNoEncontradaException {
        // SIA-12: Bloque try-catch explícito en la entidad
        try {
            // Reutilizamos buscarAsignatura, que LANZA la excepción si no la encuentra
            Asignatura asig = buscarAsignatura(codigo); 
            malla.remove(asig); 
            
        } catch (EntidadNoEncontradaException e) {
            // Se atrapa la excepción de la búsqueda y se relanza
            throw e;
        }
    }
    
    //  Calcular progreso curricular (SIA-9)
    public double calcularProgreso() {
        int totalCreditos = 0;
        int creditosAprobados = 0;

        for (Asignatura a : malla) {
            totalCreditos += a.getCreditos();

            if (a.isAprobada()) {
                creditosAprobados += a.getCreditos();
            }
        }

        if (totalCreditos == 0) {
            return 0;
        }

        return (double) creditosAprobados / totalCreditos * 100;
    }

    //  Funcionalidad útil extra 
    public List<Asignatura> obtenerAsignaturasPendientes() {
        List<Asignatura> pendientes = new ArrayList<>();

        for (Asignatura a : malla) {
            if (!a.isAprobada()) {
                pendientes.add(a);
            }
        }
        return pendientes;
    }

    //  Mostrar información del alumno
    public void mostrarInfo() {
        System.out.println("ID: " + id);
        System.out.println("Nombre: " + nombre);
        System.out.println("Carrera: " + carrera);
        System.out.println("Progreso: " + calcularProgreso() + "%");
        System.out.println("Asignaturas inscritas: " + malla.size());
        System.out.println("-----------------------------");
    }
}
