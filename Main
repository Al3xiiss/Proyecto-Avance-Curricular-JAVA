package avanceCurricular;
import javax.swing.JOptionPane;

/**
 * Clase principal que actúa como punto de entrada de la aplicación "Sistema Académico - Avance Curricular".
 * Se encarga de inicializar los registros en memoria, ejecutar la carga de datos persistentes (Batch), 
 * gestionar la selección de la interfaz de usuario por parte del cliente y asegurar 
 * el guardado de toda la información antes de finalizar la ejecución.
 */
public class Main {

    /**
     * Método principal que inicia la ejecución del programa.
     * Gestiona el flujo de vida de la aplicación cumpliendo con el requerimiento de 
     * persistencia al inicio y al final (SIA-11).
     * 
     * @param args Argumentos de línea de comandos (no se utilizan en esta implementación).
     */
    public static void main(String[] args) {
        // 1. Instanciar los registros (bases de datos en memoria)
        RegistroAlumnos registroAlumnos = new RegistroAlumnos();
        RegistroProfesores registroProfesores = new RegistroProfesores();

        // 2. SIA-11: CARGA BATCH AL INICIAR
        System.out.println("Iniciando sistema... Cargando archivos base.");
        PersistenciaData.cargarTodo(registroAlumnos, registroProfesores);

        // 3. Selección del modo de ejecución (Con ciclo de validación)
        boolean seleccionValida = false;

        while (!seleccionValida) {
            // Declaramos la variable justo donde se usa para evitar la advertencia
            String opcion = JOptionPane.showInputDialog(
                    null,
                    "Seleccione el modo de ejecucion:\n1. Consola\n2. Ventana",
                    "Sistema Academico - Avance Curricular",
                    JOptionPane.QUESTION_MESSAGE
            );

            // Validamos primero el null para que el switch no explote si el usuario cancela
            if (opcion == null) {
                JOptionPane.showMessageDialog(null, "La aplicacion fue cerrada.");
                seleccionValida = true; // Salimos del ciclo para ir al guardado y cierre
            } else {
                // Convertimos la cadena de if-else en un switch limpio
                switch (opcion) {
                    case "1":
                        MenuConsola menuConsola = new MenuConsola();
                        menuConsola.mostrarMenu(registroAlumnos, registroProfesores);
                        seleccionValida = true;
                        break;
                    case "2":
                        MenuVentana menuVentana = new MenuVentana();
                        menuVentana.mostrarMenu(registroAlumnos, registroProfesores);
                        seleccionValida = true;
                        break;
                    default:
                        JOptionPane.showMessageDialog(null, "Opción inválida. Por favor ingrese 1 o 2.", "Error", JOptionPane.WARNING_MESSAGE);
                        break;
                }
            }
        }

        // 4. SIA-11: GUARDADO BATCH AL SALIR
        System.out.println("\nGuardando cambios en archivos...");
        PersistenciaData.guardarTodo(registroAlumnos, registroProfesores);
        
        System.out.println("Cierre seguro completado.");
        System.exit(0);
    }
}
